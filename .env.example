# Bind only to loopback by default. Put an HTTPS reverse proxy in front before
# accepting connections from other machines.
TEAM_RELAY_PORT=8080
# Local only by default; use ./install-docker --bind 0.0.0.0 for network access.
TEAM_RELAY_BIND_ADDRESS=127.0.0.1
TEAM_RELAY_IMAGE=team-relay:local

# Set these to the owner of secrets/bootstrap-token on Linux (`id -u` and
# `id -g`) so the non-root relay process can read the private mounted file.
TEAM_RELAY_UID=1000
TEAM_RELAY_GID=1000

# Valkey is bundled by default. To use Redis, set both values to an appropriate
# pinned image and command, for example in your private .env file.
# TEAM_RELAY_STATE_IMAGE=redis:<pinned-tag>
# TEAM_RELAY_STATE_COMMAND=redis-server --appendonly yes
